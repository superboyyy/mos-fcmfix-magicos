<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.superboyyy.mosfcmfix"
    android:versionCode="16"
    android:versionName="0.7.1">

    <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="35" />

    <queries>
        <intent>
            <action android:name="com.google.android.c2dm.intent.RECEIVE" />
        </intent>
    </queries>

    <application android:label="MOS推送修复" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher" android:hasCode="true"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription"
            android:value="修复国行 MagicOS 对 Google FCM 推送的限制：阻止锁屏/夜间断网、推送拉起已停止的应用、推送后 30 秒放行、网络变化时检查推送连接、应用被停时保留通知。打开应用可查看状态、管理例外名单和功能开关。" />
        <meta-data android:name="xposedminversion" android:value="82" />
        <meta-data android:name="xposedscope" android:resource="@array/xposedscope" />
    </application>
</manifest>
